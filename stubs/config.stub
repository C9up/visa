---
to: {{ app.configPath('visa.ts') }}
---
import { defineConfig } from '@c9up/visa/config'
import { MemoryStore } from '@c9up/visa/stores/memory'
import env from '#start/env'

/**
 * The store here keeps everything in memory: a restart signs every user out,
 * and a second instance sees none of the first one's tokens. Fine for a single
 * development process, never for production.
 */
export default defineConfig({
  issuer: env.get('VISA_ISSUER'),
  store: new MemoryStore(),
})
