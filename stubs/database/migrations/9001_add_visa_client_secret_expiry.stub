import { Migration } from "@c9up/atlas";

/**
 * When a client's secret stops working (RFC 7591 §3.2.1).
 *
 * Its own migration rather than a line in 9000, so an application whose
 * tables already exist gets the column by running `ream configure @c9up/visa`
 * again: 9000 is already there and is left alone, this one lands and adds it.
 *
 * Null means the secret does not expire. The store reads it at every client
 * authentication: an expiry announced at registration and not stored here
 * would never be enforced.
 */
export default class AddVisaClientSecretExpiry extends Migration {
	async up() {
		this.schema.alterTable("visa_clients", (t) => {
			t.timestamp("secret_expires_at").nullable();
		});
	}

	async down() {
		this.schema.alterTable("visa_clients", (t) => {
			t.dropColumn("secret_expires_at");
		});
	}
}
