import { Migration } from "@c9up/atlas";

/**
 * What the authorization server keeps.
 *
 * Every credential column holds a HASH, never the value that was handed out —
 * a dump of these tables is not a set of working tokens.
 *
 * Two portability rules are followed deliberately and should survive an edit:
 *
 * No `t.timestamps()`. It emits `DEFAULT (NOW())`, which is not a sqlite
 * function and fails at `migration:run` on a fresh sqlite app. Every timestamp
 * here is written explicitly by the store instead.
 *
 * Every string that is a primary key or an index stays well inside MySQL's
 * InnoDB utf8mb4 limit of 3072 bytes (768 characters). A hash is 64 characters
 * of hex; an identifier is capped at 255.
 */
export default class CreateVisaTables extends Migration {
	async up() {
		this.schema.createTable("visa_clients", (t) => {
			t.string("id", 255).primary();
			t.string("name", 255).notNullable();
			// Null for a public client — a SPA or a native app has no secret to keep.
			t.string("secret_hash", 255).nullable();
			t.json("redirect_uris").notNullable();
			t.json("grant_types").notNullable();
			t.json("scopes").notNullable();
			t.string("token_endpoint_auth_method", 32).notNullable();
			t.boolean("trusted").notNullable();
			t.timestamp("created_at").notNullable();
		});

		this.schema.createTable("visa_authorization_codes", (t) => {
			t.string("code_hash", 64).primary();
			t.string("client_id", 255).notNullable();
			t.string("user_id", 255).notNullable();
			t.text("redirect_uri").notNullable();
			t.json("scopes").notNullable();
			t.string("code_challenge", 128).notNullable();
			t.string("code_challenge_method", 10).notNullable();
			t.timestamp("expires_at").notNullable();
			// Set the moment it is exchanged: the single-use guarantee is an
			// UPDATE guarded on this column being null.
			t.timestamp("consumed_at").nullable();
			t.string("nonce", 255).nullable();
			t.timestamp("created_at").notNullable();
			t.index("user_id");
		});

		this.schema.createTable("visa_access_tokens", (t) => {
			t.string("token_hash", 64).primary();
			t.string("client_id", 255).notNullable();
			// Null for `client_credentials`: there is no user behind that grant.
			t.string("user_id", 255).nullable();
			t.json("scopes").notNullable();
